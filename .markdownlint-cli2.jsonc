{
  "ignores": [
    ".beads/",
    ".claude/",
    // The ethos registry submodule is gone, but markdownlint globs the
    // filesystem rather than the index — a checkout predating the removal
    // still has the directory on disk, and its 246 files are not ours to lint.
    ".punt-labs/ethos/",
    ".punt-labs/quarry/captures/",
    ".venv/",
    ".tmp/",
    ".pytest-work/",
    "dist/",
    "node_modules/"
  ],
  "overrides": [
    {
      "files": ["tests/fixtures/*.md"],
      "config": {
        // Test fixtures intentionally use multiple h1 headings
        "MD025": false
      }
    }
  ]
}
