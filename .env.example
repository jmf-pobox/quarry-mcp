# Quarry works with zero configuration. These variables customize it.
# Reference: the Setup table in README.md.

# ONNX execution provider: cpu, cuda, or unset to auto-detect.
QUARRY_PROVIDER=

# Bearer token for quarryd. Required for a non-loopback bind.
# Generate with: openssl rand -hex 32
QUARRY_API_KEY=

# Base directory for all databases.  Left unset on purpose: the built-in
# default already resolves to ~/.punt-labs/quarry/data via Path.home().
# Set this ONLY to an absolute path.  A dotenv value is not shell-expanded,
# so a leading ~ is taken literally and would put the data root in a
# directory named "~" under the current working directory.
# QUARRY_ROOT=/absolute/path/to/quarry/data

# Max characters per chunk (~450 tokens).
CHUNK_MAX_CHARS=1800

# Overlap between consecutive chunks.
CHUNK_OVERLAP_CHARS=200
